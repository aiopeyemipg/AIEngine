digraph adf {
  graph [rankdir=LR, fontname="Helvetica", fontsize=16, labelloc=t, nodesep=0.12, ranksep=1.1,
         label="ADF graph — SPPSO_noDBSCAN  (26 kernels, compiled by aiecompiler)"];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.7];
  i0 [shape=cds, style=filled, fillcolor="#e6e6e6", label="input PLIO\nimages\ndata/pso_input.txt"];
  i2 [shape=box, style="rounded,filled", fillcolor="#cfe2ff", label="PsoMaster\nmaster\nkernels/pso_detectors.cc"];
  i3 [shape=trapezium, orientation=270, style=filled, fillcolor="#fde9d4", label="pktmerge<25>\nmerge"];
  i1 [shape=cds, style=filled, fillcolor="#e6e6e6", label="output PLIO\nresults\ndata/pso_results.txt"];
  i4 [shape=box, style="rounded,filled", fillcolor="#d8f0d2", label="PsoWorker\nworker[0]\nkernels/pso_detectors.cc"];
  i5 [shape=box, style="rounded,filled", fillcolor="#d8f0d2", label="PsoWorker\nworker[1]\nkernels/pso_detectors.cc"];
  i6 [shape=box, style="rounded,filled", fillcolor="#d8f0d2", label="PsoWorker\nworker[2]\nkernels/pso_detectors.cc"];
  i7 [shape=box, style="rounded,filled", fillcolor="#d8f0d2", label="PsoWorker\nworker[3]\nkernels/pso_detectors.cc"];
  i8 [shape=box, style="rounded,filled", fillcolor="#d8f0d2", label="PsoWorker\nworker[4]\nkernels/pso_detectors.cc"];
  i9 [shape=box, style="rounded,filled", fillcolor="#d8f0d2", label="PsoWorker\nworker[5]\nkernels/pso_detectors.cc"];
  i10 [shape=box, style="rounded,filled", fillcolor="#d8f0d2", label="PsoWorker\nworker[6]\nkernels/pso_detectors.cc"];
  i28 [shape=box, style="rounded,filled", fillcolor="#d8f0d2", label="PsoWorker\nworker[24]\nkernels/pso_detectors.cc"];
  dots0 [shape=box, style="rounded,dashed", label="... 17 more PsoWorker\n(worker[7] .. worker[23])\nsame connections"];
  i0 -> i2 [color="#1f5fbf", penwidth=2.2, label="buffer"];
  i2 -> i1 [color="#1f5fbf", penwidth=2.2, label="buffer"];
  i3 -> i2 [color="#d9822b", penwidth=1.3, style=dashed, label="pkt stream"];
  i2 -> i4 [color="#202020", penwidth=1.1, label="stream"];
  i2 -> i5 [color="#202020", penwidth=1.1, label="stream"];
  i2 -> i6 [color="#202020", penwidth=1.1, label="stream"];
  i2 -> i7 [color="#202020", penwidth=1.1, label="stream"];
  i2 -> i8 [color="#202020", penwidth=1.1, label="stream"];
  i2 -> i9 [color="#202020", penwidth=1.1, label="stream"];
  i2 -> i10 [color="#202020", penwidth=1.1, label="stream"];
  i2 -> dots0 [color="#202020", penwidth=1.1, label="stream"];
  i2 -> i28 [color="#202020", penwidth=1.1, label="stream"];
  i4 -> i3 [color="#d9822b", penwidth=1.3, style=dashed, label="pkt stream"];
  i5 -> i3 [color="#d9822b", penwidth=1.3, style=dashed, label="pkt stream"];
  i6 -> i3 [color="#d9822b", penwidth=1.3, style=dashed, label="pkt stream"];
  i7 -> i3 [color="#d9822b", penwidth=1.3, style=dashed, label="pkt stream"];
  i8 -> i3 [color="#d9822b", penwidth=1.3, style=dashed, label="pkt stream"];
  i9 -> i3 [color="#d9822b", penwidth=1.3, style=dashed, label="pkt stream"];
  i10 -> i3 [color="#d9822b", penwidth=1.3, style=dashed, label="pkt stream"];
  dots0 -> i3 [color="#d9822b", penwidth=1.3, style=dashed, label="pkt stream"];
  i28 -> i3 [color="#d9822b", penwidth=1.3, style=dashed, label="pkt stream"];
  subgraph cluster_legend { label="edges"; fontsize=10; style=dashed;
    l1 [shape=point]; l2 [shape=point]; l3 [shape=point]; l4 [shape=point]; l5 [shape=point]; l6 [shape=point];
    l1 -> l2 [color="#1f5fbf", penwidth=2.2, label="memory buffer"];
    l3 -> l4 [color="#202020", penwidth=1.1, label="AXI stream (broadcast)"];
    l5 -> l6 [color="#d9822b", penwidth=1.3, style=dashed, label="packet stream"]; }
}
